# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Local caches and development-only notes
/.pnpm-store/
*.tsbuildinfo
/.codex/
/.aws/
/.agents/
/anti-slop/
/AGENTS.md
/evals/

# Personal exports must never be committed
/backups/
/backup/
neraca-backup-*.json
neraca-transaksi-*.csv
